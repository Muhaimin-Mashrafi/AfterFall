classDiagram
    direction TB

    %% ==========================================
    %% DOMAIN MODELS (Implemented M1 & M2)
    %% ==========================================

    class Scale {
        +int MIN = 0$
        +int MAX = 100$
        +requireInRange(name, value)$ int
        +clamp(value)$ int
    }

    class SurvivorId {
        <<record>>
        +int value
        +compareTo(other) int
    }

    class EventId {
        <<record>>
        +long value
        +compareTo(other) int
    }

    class RegionId {
        <<record>>
        +int value
        +REGION_1$ RegionId
        +REGION_2$ RegionId
        +REGION_3$ RegionId
        +REGION_4$ RegionId
        +ALL$ List~RegionId~
        +compareTo(other) int
    }

    class PopulationConfig {
        <<record>>
        +int size
        +DEFAULT_POPULATION = 25$
        +MIN_POPULATION = 20$
        +MAX_POPULATION = 30$
        +defaultConfig()$ PopulationConfig
    }

    class SurvivorStatus {
        <<enumeration>>
        ALIVE
        DEAD
    }

    class Need {
        <<enumeration>>
        FOOD
        WATER
        REST
        SAFETY
    }

    class Needs {
        -Map~Need, Integer~ levels
        +level(need) int
        +set(need, level) void
        +adjust(need, delta) int
        +fullySatisfied()$ Needs
    }

    class HealthCondition {
        <<enumeration>>
        HEALTHY
        ILL
        INJURED
    }

    class Health {
        -int vitality
        -HealthCondition condition
        +vitality() int
        +condition() HealthCondition
        +setVitality(vitality) void
        +adjustVitality(delta) int
        +setCondition(condition) void
        +isDepleted() boolean
        +healthy()$ Health
    }

    class Trait {
        <<enumeration>>
        COMPASSIONATE
        SELF_INTERESTED
        FEARFUL
        AGGRESSIVE
        COOPERATIVE
        SUSPICIOUS
        RESILIENT
        AUTHORITATIVE
    }

    class Personality {
        -Map~Trait, Integer~ values
        +NEUTRAL = 50$
        +value(trait) int
        +with(trait, value) Personality
        +neutral()$ Personality
    }

    class ProfessionType {
        <<enumeration>>
        FARMER
        SCAVENGER
        MEDIC
        GUARD
        GENERAL_WORKER
        +displayName() String
    }

    class Profession {
        -ProfessionType type
        -int skill
        +type() ProfessionType
        +skill() int
        +displayName() String
        +withSkill(newSkill) Profession
    }

    class ItemType {
        <<enumeration>>
        FOOD
        WATER
        MEDICINE
    }

    class Inventory {
        -int capacity
        -Map~ItemType, Integer~ quantities
        +capacity() int
        +quantity(type) int
        +totalQuantity() int
        +freeSpace() int
        +has(type, amount) boolean
        +add(type, amount) void
        +remove(type, amount) void
    }

    class RelationshipType {
        <<enumeration>>
        STRANGER
        ACQUAINTANCE
        FRIEND
        FAMILY
        RIVAL
    }

    class RelationshipEntry {
        <<record>>
        +int day
        +RelationshipType type
        +int trust
        +int affection
        +int hostility
        +EventId sourceEventId
    }

    class Relationship {
        +MAX_HISTORY = 20$
        -SurvivorId target
        -RelationshipType type
        -int trust
        -int affection
        -int hostility
        -List~RelationshipEntry~ history
        +target() SurvivorId
        +type() RelationshipType
        +trust() int
        +affection() int
        +hostility() int
        +adjust(day, trustDelta, affectionDelta, hostilityDelta, source) void
        +changeType(day, newType, source) void
        +history() List~RelationshipEntry~
    }

    class CharacterMemory {
        +MIN_IMPACT = -100$
        +MAX_IMPACT = 100$
        -int day
        -int emotionalImpact
        -SurvivorId relatedSurvivor
        -EventId sourceEventId
        +day() int
        +emotionalImpact() int
        +relatedSurvivor() Optional~SurvivorId~
        +sourceEventId() EventId
    }

    class Survivor {
        -SurvivorId id
        -String name
        -Personality personality
        -Profession profession
        -Needs needs
        -Health health
        -Inventory inventory
        -RegionId location
        -SurvivorStatus status
        -Map~SurvivorId, Relationship~ relationships
        -List~CharacterMemory~ memories
        +id() SurvivorId
        +name() String
        +personality() Personality
        +profession() Profession
        +needs() Needs
        +health() Health
        +inventory() Inventory
        +location() Optional~RegionId~
        +status() SurvivorStatus
        +isAlive() boolean
        +markDead() void
        +changeProfession(newProfession) void
        +addRelationship(relationship) void
        +relationshipWith(other) Optional~Relationship~
        +relationships() Collection~Relationship~
        +remember(memory) void
        +memories() List~CharacterMemory~
    }

    class Region {
        -RegionId id
        -String name
        -Set~SurvivorId~ survivorIds
        +id() RegionId
        +name() String
        +survivorIds() Set~SurvivorId~
        +population() int
        +contains(survivorId) boolean
    }

    class Settlement {
        -String name
        -Map~RegionId, Region~ regions
        -Map~SurvivorId, Survivor~ survivors
        -Map~SurvivorId, RegionId~ survivorRegionIndex
        +name() String
        +population() int
        +registerSurvivor(survivor, regionId) void
        +survivor(id) Optional~Survivor~
        +contains(id) boolean
        +survivors() Collection~Survivor~
        +region(id) Optional~Region~
        +regions() Collection~Region~
        +regionOf(survivorId) Optional~RegionId~
        +survivorsIn(regionId) Set~SurvivorId~
    }

    class World {
        -Settlement settlement
        +settlement() Settlement
    }

    class InitialPopulation {
        +createDefaultSettlement(name)$ Settlement
        +createSettlement(name, config)$ Settlement
        +createDefaultWorld(name)$ World
        +createWorld(name, config)$ World
        +generateSurvivors(count)$ List~Survivor~
    }

    class SurvivorSnapshot {
        <<record>>
        +SurvivorId id
        +String name
        +Personality personality
        +Profession profession
        +Map~Need, Integer~ needLevels
        +int vitality
        +HealthCondition condition
        +Map~ItemType, Integer~ inventoryQuantities
        +int inventoryCapacity
        +Optional~RegionId~ location
        +SurvivorStatus status
        +needLevel(need) int
        +itemQuantity(type) int
        +hasItem(type, amount) boolean
        +isAlive() boolean
        +from(survivor)$ SurvivorSnapshot
    }

    %% ==========================================
    %% COMMAND PATTERN — ACTIONS (Implemented M2)
    %% ==========================================

    class ActionType {
        <<enumeration>>
        EAT
        WORK
        REST
        HEAL
        MOVE
    }

    class ActionStatus {
        <<enumeration>>
        SUCCESS
        REJECTED
    }

    class ProposedEvent {
        <<record>>
        +String eventType
        +SurvivorId survivorId
        +String summary
        +int severity
    }

    class ActionContext {
        <<record>>
        +SurvivorSnapshot survivor
        +RegionId currentRegion
        +boolean foodAvailable
        +boolean medicineAvailable
    }

    class ActionResult {
        <<record>>
        +ActionType actionType
        +ActionStatus status
        +Optional~String~ rejectionReason
        +Map~Need, Integer~ needDeltas
        +int vitalityDelta
        +Optional~HealthCondition~ newCondition
        +Map~ItemType, Integer~ inventoryDeltas
        +int workContribution
        +Optional~RegionId~ migrationRequest
        +List~ProposedEvent~ eventProposals
        +isSuccess() boolean
        +rejected(type, reason)$ ActionResult
        +builder(type)$ Builder
    }

    class Action {
        <<interface>>
        +evaluate(context) ActionResult*
        +type() ActionType*
    }

    class EatAction {
        +HUNGER_REDUCTION = 30$
        +evaluate(context) ActionResult
        +type() ActionType
    }

    class WorkAction {
        +BASE_REST_COST = -15$
        +evaluate(context) ActionResult
        +type() ActionType
    }

    class RestAction {
        +REST_RESTORE = 25$
        +evaluate(context) ActionResult
        +type() ActionType
    }

    class HealAction {
        +VITALITY_RECOVERY = 20$
        +evaluate(context) ActionResult
        +type() ActionType
    }

    class MoveAction {
        -RegionId destination
        +destination() RegionId
        +evaluate(context) ActionResult
        +type() ActionType
    }

    Action <|.. EatAction : implements
    Action <|.. WorkAction : implements
    Action <|.. RestAction : implements
    Action <|.. HealAction : implements
    Action <|.. MoveAction : implements
    MoveAction *-- "1" RegionId : destination

    Action ..> ActionContext : evaluates
    Action ..> ActionResult : returns

    %% ==========================================
    %% STRATEGY PATTERN — BEHAVIORS (Implemented M2)
    %% ==========================================

    class BehaviorType {
        <<enumeration>>
        SEEK_FOOD
        WORK
        REST
        SEEK_MEDICAL_HELP
    }

    class BehaviorConfig {
        <<record>>
        +int criticalFoodThreshold
        +int hungerThreshold
        +int criticalRestThreshold
        +int fatigueThreshold
        +int criticalVitalityThreshold
        +int healthVitalityThreshold
        +defaultConfig()$ BehaviorConfig
    }

    class BehaviorContext {
        <<record>>
        +SurvivorSnapshot survivor
        +RegionId currentRegion
        +boolean foodAvailable
        +boolean medicineAvailable
        +List~RegionId~ candidateRegions
        +of(survivor, currentRegion, food, med)$ BehaviorContext
        +withCandidates(survivor, currentRegion, food, med, candidates)$ BehaviorContext
    }

    class Behavior {
        <<interface>>
        +decide(context) Optional~Action~*
        +type() BehaviorType*
    }

    class SeekFoodBehavior {
        -BehaviorConfig config
        +decide(context) Optional~Action~
        +type() BehaviorType
    }

    class WorkBehavior {
        -BehaviorConfig config
        +decide(context) Optional~Action~
        +type() BehaviorType
    }

    class RestBehavior {
        -BehaviorConfig config
        +decide(context) Optional~Action~
        +type() BehaviorType
    }

    class SeekMedicalHelpBehavior {
        -BehaviorConfig config
        +decide(context) Optional~Action~
        +type() BehaviorType
    }

    class BehaviorSelector {
        -BehaviorConfig config
        -SeekMedicalHelpBehavior medicalBehavior
        -SeekFoodBehavior foodBehavior
        -RestBehavior restBehavior
        -WorkBehavior workBehavior
        +selectAction(context) Action
    }

    Behavior <|.. SeekFoodBehavior : implements
    Behavior <|.. WorkBehavior : implements
    Behavior <|.. RestBehavior : implements
    Behavior <|.. SeekMedicalHelpBehavior : implements

    Behavior ..> BehaviorContext : inspects
    Behavior ..> Action : selects
    BehaviorSelector o-- SeekFoodBehavior
    BehaviorSelector o-- WorkBehavior
    BehaviorSelector o-- RestBehavior
    BehaviorSelector o-- SeekMedicalHelpBehavior
    BehaviorSelector ..> Action : produces

    %% ==========================================
    %% SIMULATION ENGINE (Implemented M3)
    %% ==========================================

    class SimulationLifecycle {
        <<enumeration>>
        RUNNING
        PAUSE_REQUESTED
        PAUSED
        STOPPING
        STOPPED
        +canTransitionTo(target) boolean
        +transitionTo(target) SimulationLifecycle
        +isTerminal() boolean
        +canExecuteTick() boolean
    }

    class WorldClock {
        -long tick
        -int ticksPerDay
        -long day
        +tick() long
        +day() long
        +ticksPerDay() int
        ~advance() void
        ~rollback() void
    }

    class StateChangeApplier {
        +apply(result, survivor)$ void
        +applyBatch(proposals)$ void
    }

    class WorldView {
        <<record>>
        +long tick
        +long version
        +Map~RegionId, RegionView~ regions
        +Map~SurvivorId, SurvivorView~ survivors
        +Map~SurvivorId, RegionId~ survivorRegionMap
        +snapshot(world, tick)$ WorldView
        +snapshot(world, tick, version)$ WorldView
    }

    class RegionView {
        <<record>>
        +RegionId id
        +String name
        +List~SurvivorId~ survivorIds
    }

    class SurvivorView {
        <<record>>
        +SurvivorId id
        +String name
        +Personality personality
        +Profession profession
        +Map~Need, Integer~ needLevels
        +int vitality
        +HealthCondition condition
        +Map~ItemType, Integer~ inventoryQuantities
        +int inventoryCapacity
        +Optional~RegionId~ location
        +SurvivorStatus status
        +from(survivor)$ SurvivorView
    }

    class SurvivorActionResult {
        <<record>>
        +SurvivorId survivorId
        +int sequenceNumber
        +ActionResult actionResult
    }

    class MigrationRequest {
        <<record>>
        +SurvivorId survivorId
        +RegionId sourceRegion
        +RegionId destinationRegion
        +int actionSequence
    }

    class RegionResult {
        <<record>>
        +RegionId regionId
        +List~SurvivorActionResult~ survivorResults
        +List~MigrationRequest~ migrationRequests
        +actionResults() List~ActionResult~
    }

    class TickResult {
        -long tickNumber
        -long worldVersion
        -List~RegionResult~ regionResults
        -List~ProposedEvent~ events
        -List~ResourceClaim~ resourceClaims
        -List~MigrationRequest~ migrationRequests
        -int survivorsProcessed
        -int actionsAccepted
        -int actionsRejected
        -boolean success
        -String failureReason
        +isSuccess() boolean
        +tickNumber() long
        +worldVersion() long
    }

    %% ==========================================
    %% MULTITHREADED SIMULATION (Implemented M4)
    %% ==========================================

    class SeededRandomFactory {
        -long runSeed
        +createForRegion(regionId, tick) SplittableRandom
    }

    class RegionWorkerPool {
        +WORKER_COUNT = 4$
        -ExecutorService executor
        +poolSize() int
        +invokeAll(tasks) List~Future~RegionResult~~
        +shutdown() void
        +close() void
    }

    class RegionTask {
        <<record, Callable~RegionResult~>>
        +RegionId regionId
        +WorldView worldView
        +long tick
        +SplittableRandom rng
        +Function~BehaviorContext, Action~ actionDecider
        +call() RegionResult
    }

    class RegionWorker {
        -RegionId regionId
        -WorldView worldView
        -long tick
        -SplittableRandom rng
        -Function~BehaviorContext, Action~ actionDecider
        +evaluate() RegionResult
    }

    class MigrationCoordinator {
        -Settlement settlement
        +applyMigrations(requests) List~AppliedMigration~
        +rollbackMigrations(applied) void
    }

    class MigrationHandoff {
        +executeMigration(settlement, survivor, source, destination)$ void
    }

    class TickCoordinator {
        -World world
        -WorldClock clock
        -Function~BehaviorContext, Action~ actionDecider
        -RegionWorkerPool workerPool
        -SeededRandomFactory randomFactory
        -MigrationCoordinator migrationCoordinator
        -AtomicBoolean tickGuard
        -long worldVersion
        +executeTick() TickResult
        +worldVersion() long
        +shutdown() void
        +close() void
    }

    class SimulationEngine {
        -World world
        -WorldClock clock
        -TickCoordinator coordinator
        -SimulationLifecycle lifecycle
        -WorldView latestSnapshot
        +start() void
        +tick() TickResult
        +pause() void
        +requestPause() void
        +resume() void
        +stop() void
        +getLatestSnapshot() WorldView
        +getStatus() SimulationLifecycle
    }

    SimulationEngine *-- "1" SimulationLifecycle : manages
    SimulationEngine *-- "1" WorldClock : time
    SimulationEngine *-- "1" TickCoordinator : delegates
    SimulationEngine o-- "1" WorldView : publishes
    TickCoordinator ..> WorldView : creates
    TickCoordinator *-- "1" RegionWorkerPool : manages
    TickCoordinator *-- "1" SeededRandomFactory : generates RNG
    TickCoordinator *-- "1" MigrationCoordinator : resolves migration
    TickCoordinator ..> StateChangeApplier : applies batch
    TickCoordinator ..> TickResult : produces
    TickCoordinator o-- "1" World : accesses
    TickCoordinator o-- "1" WorldClock : advances
    RegionWorkerPool ..> RegionTask : executes
    RegionTask ..> RegionWorker : delegates
    RegionWorker ..> RegionResult : produces
    MigrationCoordinator ..> MigrationHandoff : uses
    RegionResult *-- "0..*" SurvivorActionResult : contains
    RegionResult *-- "0..*" MigrationRequest : contains
    TickResult *-- "0..*" MigrationRequest : preserves
    TickResult *-- "0..*" RegionResult : contains
    WorldView *-- "4" RegionView : contains
    WorldView *-- "20..30" SurvivorView : contains

    %% ==========================================
    %% FUTURE COMPONENTS (Planned M5)
    %% ==========================================

    class Crisis {
        <<abstract, planned M5>>
        +applyEffects(world) void*
    }
    class Resource {
        <<planned M5>>
        +consume(amount) void
    }

    %% Core Relationships
    World *-- "1" Settlement : contains
    Settlement *-- "4" Region : manages
    Settlement o-- "20..30" Survivor : registers
    Region o-- "0..*" SurvivorId : references
    Survivor *-- "1" SurvivorId : identity
    Survivor *-- "1" Personality : composition
    Survivor *-- "1" Profession : role object
    Survivor *-- "1" Needs : composition
    Survivor *-- "1" Health : composition
    Survivor *-- "1" Inventory : composition
    Survivor o-- "0..1" RegionId : location
    Survivor *-- "0..*" Relationship : tracks
    Survivor *-- "0..*" CharacterMemory : remembers
    Survivor --> SurvivorStatus : state
    Profession --> ProfessionType
    Needs --> Need
    Health --> HealthCondition
    Relationship --> RelationshipType
    Relationship *-- "0..20" RelationshipEntry : bounded history
    RelationshipEntry --> RelationshipType
    RelationshipEntry --> EventId
    CharacterMemory --> EventId
    CharacterMemory --> SurvivorId
    Inventory --> ItemType

    InitialPopulation ..> World : creates
    InitialPopulation ..> Settlement : creates
    InitialPopulation ..> PopulationConfig : uses

    SurvivorSnapshot ..> Survivor : snapshots

    Crisis ..> World : planned M5
    Resource ..> Settlement : planned M5
