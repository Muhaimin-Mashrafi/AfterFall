---
title: "AfterFall component diagram (V1, as implemented)"
---
%% Layers read top to bottom. Arrows point from the depending component to the component it uses.
%% The simulation core (inside the Plain-Java core box) imports no Spring, JPA or PostgreSQL class (checked by CoreBoundaryTest).
%% Dotted arrows with <<implements>> show Dependency Inversion: adapters implement ports owned by the application layer.
flowchart TB
    classDef ui fill:#ECE8E1,stroke:#171816,color:#171816
    classDef web fill:#D9D4C7,stroke:#171816,color:#171816
    classDef app fill:#E2DDD2,stroke:#171816,color:#171816
    classDef core fill:#FFFFFF,stroke:#171816,color:#171816
    classDef port fill:#F4F1EA,stroke:#79504A,stroke-width:2px,color:#171816
    classDef infra fill:#D0CBC0,stroke:#171816,color:#171816
    classDef ext fill:#827C6D,stroke:#171816,color:#FFFFFF

    Browser["<b>Browser</b><br/>index / story / people / records .html<br/>api.js (REST) + ws.js (STOMP)"]:::ui

    subgraph Web["Web layer: com.afterfall.web, config"]
        Rest["REST controllers<br/>Simulation, Story, Observer,<br/>Recap, Metrics"]:::web
        Stomp["WebSocketConfig +<br/>WebSocketBroadcaster"]:::web
    end

    subgraph App["Application layer: com.afterfall.application"]
        Service["SimulationService<br/>(facade over the core)"]:::app
        Ports["Ports: RunRepository, EventRecorder,<br/>EvidenceDiscoveryRepository"]:::port
    end

    subgraph Core["Plain-Java core: domain, simulation, observer, events, narrator, choice, chapter, recap"]
        direction TB
        Engine["SimulationEngine<br/>(lifecycle state machine)"]:::core
        Tick["TickCoordinator<br/>(sole writer, ordered merge)"]:::core
        Pool["RegionWorkerPool<br/>4 worker threads"]:::core
        Domain["Domain model + CrisisManager<br/>World, Settlement, Survivor, ResourceStock"]:::core
        Observer["ObserverAI<br/>4 InterventionPolicy strategies"]:::core
        Story["ChoiceCoordinator + ChapterManager"]:::core
        Bus["EventBus<br/>(one queue + thread per subscriber)"]:::core
        Narrator["Narrator<br/>51 authored templates"]:::core
        Recap["EvidenceService + RecapGenerator"]:::core
        Engine --> Tick
        Tick -->|"immutable WorldView in,<br/>RegionResult out"| Pool
        Tick -->|"merges into"| Domain
        Tick --> Observer
        Tick --> Story
        Tick -->|"publish(events)"| Bus
        Bus --> Narrator
    end

    subgraph Infra["Infrastructure layer: com.afterfall.infrastructure"]
        Async["AsyncEventRecorder<br/>(writer thread, critical + bounded minor queue)"]:::infra
        Jpa["JPA adapters (PostgreSQL)"]:::infra
        Mem["In-memory adapters<br/>(profile: inmemory)"]:::infra
    end

    DB[("PostgreSQL 17<br/>database afterfall")]:::ext

    Browser -->|"HTTP"| Rest
    Stomp -->|"STOMP /topic/*"| Browser
    Rest --> Service
    Service --> Stomp
    Service --> Engine
    Service --> Story
    Service --> Recap
    Service --> Observer
    Service --> Ports
    Bus -.->|"subscriber"| Async
    Async --> Ports
    Jpa -.->|"implements"| Ports
    Mem -.->|"implements"| Ports
    Jpa -->|"JDBC"| DB
